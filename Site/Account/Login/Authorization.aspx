            });
        }

        function sw2() {
            swal({
                title: 'Все поля обязательный к заполнению.',
                position: "bottom",
                allowOutsideClick: false,
                allowEscapeKey: false,
                allowEnterKey: false,
                showConfirmButton: false,
                showCancelButton: false,
                background: null,
                backdrop: null,
                timer: 1500
            });
