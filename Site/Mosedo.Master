    <script type="text/javascript">
        function ClickNumberDoc(element) {
            var numberdoc = element.textContent;
            var area = document.createElement('textarea');
            document.body.appendChild(area);
            area.value = numberdoc;
            area.select();
            document.execCommand("copy");
            document.body.removeChild(area);
            swal({
                title: "Уведомление",
                text: "Скопирован текст: " + numberdoc,
                position: "bottom",
                allowOutsideClick: false,
                allowEscapeKey: false,
                allowEnterKey: false,
                showConfirmButton: false,
                showCancelButton: false,
                background: null,
                backdrop: null,
                timer: 1500
            });
        }

        function ClickRow(element) {
            var nameobject = element.cells[1].textContent;
            window.location.href = '/One_page.aspx?map=' + nameobject;
        }

        function ClickRow2(element) {
            var nameobject = element.cells[0].textContent;
            window.location.href = '/One_page.aspx?map=' + nameobject;
        }

        function ClickOtch(element) {
            window.location.href = '/One_page.aspx?map=' + element.textContent;
        }

        function ClickDoc() {
            window.location.href = '/FlaseError.aspx';
        }

        function ClickRow_aut(element) {
            alert("dsd")
            var id_user = element.cells[0].textContent;
            window.location.href = '/Authorization.aspx?id_user=' + id_user;
        }

        function openImageWindow(src) {
            var image = new Image();
            image.src = src;
            window.open(src, "Image", "width=1200,height=800");
        }

        function ClickCell3(name) {
            var nameobject = name;
            window.location.href = '/One_page.aspx?map=' + nameobject;
        }
    </script>

