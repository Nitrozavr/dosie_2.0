    <script>
        $(document).ready(function () {
            $("div[id$='dosiee']").click(function () {
                $('div.personal_area').toggleClass('personal_area2');
            });
            $("div[class$='profile']").click(function () {
                $('div.personal_areaa').toggleClass('personal_areaa2');
            });
            $("div[class$='redact']").click(function () {
                $('div.redact_area').toggleClass('redact_area2');
            });
        });

        $(document).mouseup(function (e) {
            var container = $("div.personal_area");
            if (container.has(e.target).length === 0) container.removeClass('personal_area2');
        });

        $(document).mouseup(function (e) {
            var container = $("div.personal_areaa");
            if (container.has(e.target).length === 0) container.removeClass('personal_areaa2');
        });

        $(document).mouseup(function (e) {
            var container = $("div.redact_area");
            if (container.has(e.target).length === 0) container.removeClass('redact_area2');
        });
    </script>

